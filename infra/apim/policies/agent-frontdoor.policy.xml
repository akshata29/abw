<!--
  ABW agent front door - the user's first stop on the way to a Foundry agent (Entra-authenticated, revocable, metered, observable).

  Layers executed here (each independently denies):
    1. validate-jwt        signature, issuer, audience (the Foundry data plane, https://ai.azure.com), tenant, expiry -> 401
    2. kill switch         revoked user object ids (same named value the MCP gateway uses)                           -> 403 revoked
    3. rate-limit-by-key   agent calls per user per minute                                                           -> 429
    4. llm-token-limit     per-user token budget per hour (named value abw-agent-token-quota)                         -> 403 (budget) / 429
    5. telemetry           decision metric + trace, and llm-emit-token-metric (tokens by user and agent) for FinOps
  The user's own token is forwarded UNCHANGED: Foundry still authorises the person (Azure AI User / Agent Consumer) and the agent's
  tools still receive the user's identity (OAuth identity passthrough -> on-behalf-of at each MCP server). The gateway adds control
  and attribution; it never swaps the caller for a service identity.
  Named values:  abw-tenant-id  abw-deny-oids  abw-agent-token-quota  abw-agent-rpm
-->
<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" require-scheme="Bearer" require-expiration-time="true" require-signed-tokens="true" clock-skew="60" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="jwt">
      <openid-config url="https://login.microsoftonline.com/{{abw-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>https://ai.azure.com</audience>
      </audiences>
      <issuers>
        <issuer>https://sts.windows.net/{{abw-tenant-id}}/</issuer>
        <issuer>https://login.microsoftonline.com/{{abw-tenant-id}}/v2.0</issuer>
      </issuers>
      <required-claims>
        <claim name="tid" match="all">
          <value>{{abw-tenant-id}}</value>
        </claim>
      </required-claims>
    </validate-jwt>
    <set-variable name="abw-oid" value="@{
      var j = (Jwt)context.Variables[&quot;jwt&quot;];
      return j.Claims.ContainsKey(&quot;oid&quot;) ? j.Claims[&quot;oid&quot;].FirstOrDefault() : &quot;unknown&quot;;
    }" />
    <set-variable name="abw-upn" value="@{
      var j = (Jwt)context.Variables[&quot;jwt&quot;];
      foreach (var k in new string[] { &quot;upn&quot;, &quot;unique_name&quot;, &quot;preferred_username&quot; }) {
        if (j.Claims.ContainsKey(k)) { return j.Claims[k].FirstOrDefault(); }
      }
      return &quot;unknown&quot;;
    }" />
    <set-variable name="abw-agent" value="@{
      try {
        var b = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
        var a = b[&quot;agent_reference&quot;];
        return a != null ? ((string)a[&quot;name&quot;] ?? &quot;n/a&quot;) : &quot;n/a&quot;;
      } catch { return &quot;n/a&quot;; }
    }" />
    <set-variable name="abw-deny" value="@{
      var oid = (string)context.Variables[&quot;abw-oid&quot;];
      if (&quot;{{abw-deny-oids}}&quot;.Split(',').Contains(oid)) { return &quot;revoked&quot;; }
      return &quot;&quot;;
    }" />
    <emit-metric name="abw-gateway-decisions" value="1" namespace="abw">
      <dimension name="server" value="agents" />
      <dimension name="decision" value="@(((string)context.Variables[&quot;abw-deny&quot;]) == &quot;&quot; ? &quot;allow&quot; : &quot;deny&quot;)" />
      <dimension name="reason" value="@(((string)context.Variables[&quot;abw-deny&quot;]) == &quot;&quot; ? &quot;ok&quot; : (string)context.Variables[&quot;abw-deny&quot;])" />
      <dimension name="oid" value="@((string)context.Variables[&quot;abw-oid&quot;])" />
    </emit-metric>
    <trace source="abw-gateway" severity="information">
      <message>@(&quot;gateway decision server=agents decision=&quot; + (((string)context.Variables[&quot;abw-deny&quot;]) == &quot;&quot; ? &quot;allow&quot; : &quot;deny:&quot; + (string)context.Variables[&quot;abw-deny&quot;]))</message>
      <metadata name="server" value="agents" />
      <metadata name="oid" value="@((string)context.Variables[&quot;abw-oid&quot;])" />
      <metadata name="upn" value="@((string)context.Variables[&quot;abw-upn&quot;])" />
      <metadata name="agent" value="@((string)context.Variables[&quot;abw-agent&quot;])" />
      <metadata name="reason" value="@(((string)context.Variables[&quot;abw-deny&quot;]) == &quot;&quot; ? &quot;ok&quot; : (string)context.Variables[&quot;abw-deny&quot;])" />
      <metadata name="request_id" value="@(context.RequestId.ToString())" />
    </trace>
    <choose>
      <when condition="@(((string)context.Variables[&quot;abw-deny&quot;]) != &quot;&quot;)">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-abw-request-id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
          </set-header>
          <set-header name="x-abw-gateway" exists-action="override">
            <value>apim-agent-front-door</value>
          </set-header>
          <set-body>@{
            return new JObject(
              new JProperty("error", new JObject(
                new JProperty("code", "forbidden"),
                new JProperty("message", "Blocked at the agent front door: " + (string)context.Variables["abw-deny"]),
                new JProperty("reason", (string)context.Variables["abw-deny"]),
                new JProperty("request_id", context.RequestId.ToString())))).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="{{abw-agent-rpm}}" renewal-period="60" counter-key="@((string)context.Variables[&quot;abw-oid&quot;])" />
    <llm-token-limit counter-key="@((string)context.Variables[&quot;abw-oid&quot;])" token-quota="{{abw-agent-token-quota}}" token-quota-period="Hourly" estimate-prompt-tokens="false" remaining-quota-tokens-header-name="x-abw-tokens-remaining" tokens-consumed-header-name="x-abw-tokens-consumed" />
    <llm-emit-token-metric namespace="abw-agent">
      <dimension name="oid" value="@((string)context.Variables[&quot;abw-oid&quot;])" />
      <dimension name="upn" value="@((string)context.Variables[&quot;abw-upn&quot;])" />
      <dimension name="agent" value="@((string)context.Variables[&quot;abw-agent&quot;])" />
    </llm-emit-token-metric>
    <set-header name="x-abw-request-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </inbound>
  <backend>
    <forward-request timeout="240" />
  </backend>
  <outbound>
    <base />
    <set-header name="x-abw-request-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="x-abw-gateway" exists-action="override">
      <value>apim-agent-front-door</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <choose>
      <when condition="@(context.Response.StatusCode == 401)">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-abw-request-id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
          </set-header>
          <set-header name="x-abw-gateway" exists-action="override">
            <value>apim-agent-front-door</value>
          </set-header>
          <set-body>@{
            return new JObject(
              new JProperty("error", new JObject(
                new JProperty("code", "unauthorized"),
                new JProperty("message", "A valid Entra access token for the Foundry data plane (https://ai.azure.com) is required at the agent front door."),
                new JProperty("request_id", context.RequestId.ToString())))).ToString();
          }</set-body>
        </return-response>
      </when>
      <when condition="@(context.Response.StatusCode == 403 || context.Response.StatusCode == 429)">
        <set-variable name="abw-deny-kind" value="@(context.Response.StatusCode == 403 ? &quot;token_quota&quot; : &quot;rate_limit&quot;)" />
        <set-variable name="abw-retry-after" value="@(context.Response.Headers.GetValueOrDefault(&quot;Retry-After&quot;, &quot;60&quot;))" />
        <emit-metric name="abw-gateway-decisions" value="1" namespace="abw">
          <dimension name="server" value="agents" />
          <dimension name="decision" value="deny" />
          <dimension name="reason" value="@((string)context.Variables[&quot;abw-deny-kind&quot;])" />
          <dimension name="oid" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;abw-oid&quot;, &quot;unknown&quot;))" />
        </emit-metric>
        <trace source="abw-gateway" severity="information">
          <message>@(&quot;gateway decision server=agents decision=deny:&quot; + (string)context.Variables[&quot;abw-deny-kind&quot;])</message>
          <metadata name="server" value="agents" />
          <metadata name="oid" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;abw-oid&quot;, &quot;unknown&quot;))" />
          <metadata name="upn" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;abw-upn&quot;, &quot;unknown&quot;))" />
          <metadata name="agent" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;abw-agent&quot;, &quot;n/a&quot;))" />
          <metadata name="reason" value="@((string)context.Variables[&quot;abw-deny-kind&quot;])" />
          <metadata name="request_id" value="@(context.RequestId.ToString())" />
        </trace>
        <return-response>
          <set-status code="@(context.Response.StatusCode)" reason="@(context.Response.StatusCode == 403 ? &quot;Forbidden&quot; : &quot;Too Many Requests&quot;)" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="Retry-After" exists-action="override">
            <value>@((string)context.Variables["abw-retry-after"])</value>
          </set-header>
          <set-header name="x-abw-request-id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
          </set-header>
          <set-header name="x-abw-gateway" exists-action="override">
            <value>apim-agent-front-door</value>
          </set-header>
          <set-body>@{
            var quota = (string)context.Variables["abw-deny-kind"] == "token_quota";
            return new JObject(
              new JProperty("error", new JObject(
                new JProperty("code", quota ? "token_quota_exceeded" : "rate_limited"),
                new JProperty("message", quota
                  ? "Blocked at the agent front door: this user's token budget for the hour is used up (enforced per Entra user by llm-token-limit)."
                  : "Blocked at the agent front door: too many agent calls per minute for this user (enforced per Entra user by rate-limit-by-key)."),
                new JProperty("reason", (string)context.Variables["abw-deny-kind"]),
                new JProperty("retry_after_seconds", (string)context.Variables["abw-retry-after"]),
                new JProperty("request_id", context.RequestId.ToString())))).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
