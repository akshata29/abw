<!--
  ABW gateway policy — the "typical POC" legacy MCP: a shared APIM subscription key, NO user context.
  This is the "before" picture. The server behind it runs as a broad shared identity.
-->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="120" renewal-period="60" counter-key="@(context.Subscription != null ? context.Subscription.Id : context.Request.IpAddress)" />
    <set-header name="x-abw-request-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="x-abw-gateway" exists-action="override">
      <value>apim-legacy</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
