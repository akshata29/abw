// 07-jumpbox.bicep - Agents Behind the Wall: optional operator jump box (additive stage; not part of the story).
//
// Why it exists: every data plane in this platform is private-endpoint-only BY DESIGN (Foundry, Search,
// Cosmos, Storage, Key Vault, ACR, APIM). From a laptop the Azure portal's data pages (Foundry Knowledge,
// AI Search explorer, Cosmos Data Explorer, Storage browser) fail with a network error -- which is the point
// of the demo. This stage puts one small Windows VM INSIDE the VNet so the presenter can open those same
// pages from a browser that resolves the private DNS zones to the 10.42.1.x private endpoints.
//
//   * snet-jump 10.42.4.0/27 : its own NSG (RDP only from the VNet / Bastion platform address; the internet is
//                              denied) + the shared NAT gateway (the portal and Entra sign-in need outbound 443).
//   * No public IP anywhere. Trusted Launch Windows Server 2022, Standard SSD, auto-shutdown 03:00 Central.
//   * Bastion Developer (free, shared pool): browser RDP from the portal, VM > Connect > Bastion; one session.
//
// IMPORTANT: 01-network.bicep declares its subnets INLINE. Re-deploying that stage after this one would try to
// remove snet-jump (the NIC is in use) and fail. Do not re-run the network stage once this stage is applied.
//
// Secrets: adminPassword is generated and held by scripts\jumpbox.ps1 (.secrets\jumpbox.json); never in this repo.

targetScope = 'resourceGroup'

@description('Azure region (must support Bastion Developer).')
param location string = resourceGroup().location

@description('Existing virtual network (created by 01-network.bicep).')
param vnetName string

@description('Existing NAT gateway (created by 01-network.bicep).')
param natGatewayName string

@description('Jump subnet name.')
param jumpSubnetName string = 'snet-jump'

@description('Jump subnet prefix (free space inside 10.42.0.0/16).')
param jumpSubnetPrefix string = '10.42.4.0/27'

@description('NSG name for the jump subnet (CAF: nsg-<workload>-<purpose>-<region>-<instance>).')
param jumpNsgName string

@description('VM name (CAF: vm-<workload>-<purpose>-<region>-<instance>).')
param vmName string

@description('Windows computer name (15 characters maximum).')
@maxLength(15)
param computerName string = 'abw-jump'

@description('NIC name.')
param nicName string

@description('OS disk name.')
param osDiskName string

@description('Bastion Developer resource name.')
param bastionName string

@description('Create the Bastion Developer resource here. When false the portal creates it on the first Connect.')
param deployBastion bool = true

@description('VM size. Several families (B, v5 and older) are NotAvailableForSubscription in this tenant; v7 is open. 2 vCPU / 8 GiB is enough for a portal browser.')
param vmSize string = 'Standard_D2as_v7'

@description('Local administrator user name.')
param adminUsername string = 'abwadmin'

@description('Local administrator password (generated by scripts\\jumpbox.ps1).')
@secure()
param adminPassword string

@description('Daily auto-shutdown time, HHmm.')
param shutdownTime string = '0300'

@description('Windows time zone id for the auto-shutdown schedule.')
param shutdownTimeZone string = 'Central Standard Time'

@description('Resource tags.')
param tags object = {}

resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' existing = {
  name: vnetName
}

resource natGateway 'Microsoft.Network/natGateways@2024-05-01' existing = {
  name: natGatewayName
}

resource jumpNsg 'Microsoft.Network/networkSecurityGroups@2024-05-01' = {
  name: jumpNsgName
  location: location
  tags: tags
  properties: {
    securityRules: [
      {
        // Bastion Developer reaches the VM from the platform address, which the VirtualNetwork tag covers.
        name: 'allow-in-rdp-3389-bastion'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: 'VirtualNetwork'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '3389'
        }
      }
      {
        name: 'deny-in-internet-all'
        properties: {
          priority: 4000
          direction: 'Inbound'
          access: 'Deny'
          protocol: '*'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '*'
        }
      }
    ]
  }
}

// Created with our NSG and the NAT gateway attached from the start, so the baseline policy that auto-attaches
// an empty NSG to bare subnets has nothing to do here.
resource jumpSubnet 'Microsoft.Network/virtualNetworks/subnets@2024-05-01' = {
  parent: vnet
  name: jumpSubnetName
  properties: {
    addressPrefix: jumpSubnetPrefix
    defaultOutboundAccess: false
    networkSecurityGroup: { id: jumpNsg.id }
    natGateway: { id: natGateway.id }
  }
}

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = {
  name: nicName
  location: location
  tags: tags
  properties: {
    enableAcceleratedNetworking: true
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: jumpSubnet.id }
          privateIPAllocationMethod: 'Dynamic'
        }
      }
    ]
  }
}

resource vm 'Microsoft.Compute/virtualMachines@2024-07-01' = {
  name: vmName
  location: location
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    osProfile: {
      computerName: computerName
      adminUsername: adminUsername
      adminPassword: adminPassword
      windowsConfiguration: {
        provisionVMAgent: true
        enableAutomaticUpdates: true
        timeZone: shutdownTimeZone
      }
    }
    storageProfile: {
      imageReference: {
        publisher: 'MicrosoftWindowsServer'
        offer: 'WindowsServer'
        sku: '2022-datacenter-azure-edition'
        version: 'latest'
      }
      osDisk: {
        name: osDiskName
        createOption: 'FromImage'
        caching: 'ReadWrite'
        deleteOption: 'Delete'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
      }
      // The v6/v7 general-purpose sizes are NVMe-only; the image advertises SCSI + NVMe.
      diskControllerType: 'NVMe'
    }
    networkProfile: {
      networkInterfaces: [
        {
          id: nic.id
          properties: {
            primary: true
            deleteOption: 'Delete'
          }
        }
      ]
    }
    securityProfile: {
      securityType: 'TrustedLaunch'
      uefiSettings: {
        secureBootEnabled: true
        vTpmEnabled: true
      }
    }
    diagnosticsProfile: {
      bootDiagnostics: { enabled: true }
    }
  }
}

// A stopped VM costs only its disk; the schedule is a backstop for "I forgot to stop it".
resource autoShutdown 'Microsoft.DevTestLab/schedules@2018-09-15' = {
  name: 'shutdown-computevm-${vmName}'
  location: location
  tags: tags
  properties: {
    status: 'Enabled'
    taskType: 'ComputeVmShutdownTask'
    dailyRecurrence: { time: shutdownTime }
    timeZoneId: shutdownTimeZone
    notificationSettings: {
      status: 'Disabled'
      timeInMinutes: 30
    }
    targetResourceId: vm.id
  }
}

// Developer SKU: no AzureBastionSubnet and no public IP; it only needs the VNet. Created after the VM so two
// writes never hit the VNet at the same time.
resource bastion 'Microsoft.Network/bastionHosts@2024-05-01' = if (deployBastion) {
  name: bastionName
  location: location
  tags: tags
  sku: { name: 'Developer' }
  properties: {
    virtualNetwork: { id: vnet.id }
  }
  dependsOn: [
    vm
  ]
}

output vmName string = vm.name
output vmId string = vm.id
output nicName string = nic.name
output privateIp string = nic.properties.ipConfigurations[0].properties.privateIPAddress
output subnetId string = jumpSubnet.id
output nsgName string = jumpNsg.name
output bastionName string = deployBastion ? bastionName : ''
output vmSize string = vmSize
