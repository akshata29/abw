   "versionNonce": 16442596,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Two meters in the front-door policy.\nToken meter (llm-emit-token-metric, namespace\nabw-agent): tokens by user oid, upn and agent.\nDecision meter and trace (emit-metric\nabw-gateway-decisions, trace abw-gateway): allow or\ndeny, reason, user oid, request_id.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d11_0156",
   "originalText": "Two meters in the front-door policy.\nToken meter (llm-emit-token-metric, namespace\nabw-agent): tokens by user oid, upn and agent.\nDecision meter and trace (emit-metric\nabw-gateway-decisions, trace abw-gateway): allow or\ndeny, reason, user oid, request_id.",
   "autoResize": true,
   "lineHeight": 1.25
  },
