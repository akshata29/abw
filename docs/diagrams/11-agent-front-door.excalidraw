   "versionNonce": 9425753,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Named values the checks read. An operator changes them with no redeploy; APIM\napplies a change within seconds to about a minute.\nabw-tenant-id: the tenant for the issuer and tid checks\nabw-deny-oids: the users the kill switch refuses\nabw-agent-rpm: calls per minute per user, default 60\nabw-agent-token-quota: tokens per user per hour, default 250000",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d11_0089",
   "originalText": "Named values the checks read. An operator changes them with no redeploy; APIM\napplies a change within seconds to about a minute.\nabw-tenant-id: the tenant for the issuer and tid checks\nabw-deny-oids: the users the kill switch refuses\nabw-agent-rpm: calls per minute per user, default 60\nabw-agent-token-quota: tokens per user per hour, default 250000",
   "autoResize": true,
   "lineHeight": 1.25
  },
