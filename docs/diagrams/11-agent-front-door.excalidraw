   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Direct calls skip the front door. The legacy PoC agent is\ncalled this way on purpose (the before picture: a shared\nkey, no user). A valid Entra token also works here\nbecause public network access is on; in production a\nprivate endpoint makes APIM the only way in.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d11_0111",
   "originalText": "Direct calls skip the front door. The legacy PoC agent is\ncalled this way on purpose (the before picture: a shared\nkey, no user). A valid Entra token also works here\nbecause public network access is on; in production a\nprivate endpoint makes APIM the only way in.",
   "autoResize": true,
   "lineHeight": 1.25
  },
