   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Budget budget-abw-demo-<region>-001: USD 1,200\na month by default. Mails the resource group\nOwners at 50, 80 and 100 % actual and 100 %\nforecast. An alert, not a cap.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d11_0154",
   "originalText": "Budget budget-abw-demo-<region>-001: USD 1,200\na month by default. Mails the resource group\nOwners at 50, 80 and 100 % actual and 100 %\nforecast. An alert, not a cap.",
   "autoResize": true,
   "lineHeight": 1.25
  },
