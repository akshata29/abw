   "link": null,
   "locked": false,
   "text": "Main flow (numbers on the arrows)",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Main flow (numbers on the arrows)",
   "autoResize": true,
