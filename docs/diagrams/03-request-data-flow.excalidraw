   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "T1: Entra token for Foundry (audience\nhttps://ai.azure.com).\nT2: Entra token for the wall MCP API\n(audience = the API app, scope\nTools.Read, app roles).\nT3: managed identity token (audience\napi://AzureADTokenExchange).\nT4: Entra token for Storage (audience\nhttps://storage.azure.com, oid = Wes).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "T1: Entra token for Foundry (audience\nhttps://ai.azure.com).\nT2: Entra token for the wall MCP API\n(audience = the API app, scope\nTools.Read, app roles).\nT3: managed identity token (audience\napi://AzureADTokenExchange).\nT4: Entra token for Storage (audience\nhttps://storage.azure.com, oid = Wes).",
   "autoResize": true,
   "lineHeight": 1.25
  },
