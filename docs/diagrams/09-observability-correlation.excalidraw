  {
   "id": "d09_0214",
   "type": "text",
   "x": 2030.0,
   "y": 469.5,
   "width": 278.32,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
