   "text": "AbwFullChain(anyId, lookback, tokenIds)",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d09_0170",
   "originalText": "AbwFullChain(anyId, lookback, tokenIds)",
