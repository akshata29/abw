   "locked": false
  },
  {
   "id": "d09_0173",
   "type": "text",
   "x": 1536.58,
   "y": 302.5,
   "width": 370.83,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2270014,
   "version": 1,
   "versionNonce": 18118234,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "One id in, the whole run out, one row per hop (steps\n0-12). The id can be a tool-call request_id, a\nfront-door request id or the 32-hex trace id; it is\nexpanded to every request id and trace id through\nthree maps: APIM, the MCP audit and the tool-result\necho. Optional tokenIds: the uti values a caller sent,\nfor a call the gateway refused.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d09_0172",
   "originalText": "One id in, the whole run out, one row per hop (steps\n0-12). The id can be a tool-call request_id, a\nfront-door request id or the 32-hex trace id; it is\nexpanded to every request id and trace id through\nthree maps: APIM, the MCP audit and the tool-result\necho. Optional tokenIds: the uti values a caller sent,\nfor a call the gateway refused.",
   "autoResize": true,
   "lineHeight": 1.25
  },
