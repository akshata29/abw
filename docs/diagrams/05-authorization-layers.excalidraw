  },
  {
   "id": "d05_0124",
   "type": "text",
   "x": 1206.0,
   "y": 1406.0,
   "width": 602.43,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp05_003"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1481971,
   "version": 1,
   "versionNonce": 12986461,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "1. Request reaches Wall 0: the Foundry guardrail screens the content.\n2. It passes to Wall 1: the gateway checks token, role, rate and kill switch.\n3. It passes to Wall 2: the MCP server re-checks the token and applies the tool's rule.\n4. It passes to Wall 3: the data plane's own roles answer for the user.\n5. Only when all four walls say yes does the call reach the data.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. Request reaches Wall 0: the Foundry guardrail screens the content.\n2. It passes to Wall 1: the gateway checks token, role, rate and kill switch.\n3. It passes to Wall 2: the MCP server re-checks the token and applies the tool's rule.\n4. It passes to Wall 3: the data plane's own roles answer for the user.\n5. Only when all four walls say yes does the call reach the data.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d05_0095",
   "type": "ellipse",
   "x": 157.0,
   "y": 266.0,
   "width": 36.0,
   "height": 36.0,
   "angle": 0,
