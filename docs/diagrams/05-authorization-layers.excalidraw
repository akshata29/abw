   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Stops at Wall 3. A user holds the Wall.Falcon role but is not in sg-abw-wall-falcon: the\ngateway and the MCP server allow it, Storage answers 403 (Sentinel ABW-007).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d05_0115",
   "originalText": "Stops at Wall 3. A user holds the Wall.Falcon role but is not in sg-abw-wall-falcon: the\ngateway and the MCP server allow it, Storage answers 403 (Sentinel ABW-007).",
   "autoResize": true,
   "lineHeight": 1.25
  },
