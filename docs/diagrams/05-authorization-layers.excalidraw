   "versionNonce": 12672274,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "- Each wall is a different system with its own deny, so getting past one still meets the next.\n- Wall 2 checks the token again instead of trusting the gateway, and Wall 3 decides on the user's own token T4, never on the server's\n  identity for user data (the restricted-list read and the audit append use it).\n- Wall 0 is detective and best effort (a preview control). The three identity walls, 1, 2 and 3, make a call safe.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "- Each wall is a different system with its own deny, so getting past one still meets the next.\n- Wall 2 checks the token again instead of trusting the gateway, and Wall 3 decides on the user's own token T4, never on the server's\n  identity for user data (the restricted-list read and the audit append use it).\n- Wall 0 is detective and best effort (a preview control). The three identity walls, 1, 2 and 3, make a call safe.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d05_0123",
   "type": "text",
   "x": 1206.0,
   "y": 1373.0,
   "width": 134.48,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
