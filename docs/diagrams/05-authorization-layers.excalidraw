   "link": null,
   "locked": false,
   "text": "A valid Entra token for this MCP server: signature,\naudience, tenant. Then who and what: kill switch, client\nallow-list, scope, role. Then volume: 120 calls a minute\nper user.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
