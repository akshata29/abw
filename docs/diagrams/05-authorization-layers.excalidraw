   "versionNonce": 12358087,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Azure Policy (initiative abw-agent-platform-controls) is not a wall: it decides what may exist, not what a request may do. Five control families: no keys, private data planes, approved tools and models, guardrails attached, hygiene. A custom Deny refuses Foundry connections to MCP\ntargets that are not approved.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d05_0117",
   "originalText": "Azure Policy (initiative abw-agent-platform-controls) is not a wall: it decides what may exist, not what a request may do. Five control families: no keys, private data planes, approved tools and models, guardrails attached, hygiene. A custom Deny refuses Foundry connections to MCP\ntargets that are not approved.",
   "autoResize": true,
   "lineHeight": 1.25
  },
