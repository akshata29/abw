  },
  {
   "id": "d02_0203",
   "type": "text",
   "x": 76.0,
   "y": 2009.0,
   "width": 127.84,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
