   "versionNonce": 10263468,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "NSG nsg-abw-apim-<region>-001 (outbound\nrules only)\n100 allow AzureKeyVault 443: an APIM v2\nplatform dependency\n110 allow VirtualNetwork 443: the MCP apps\nand the Foundry private endpoints\n120 allow Internet 443: the vendor mock,\nEntra and Monitor through the NAT\nOnly these three custom rules; no custom\ninbound rules.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0097",
   "originalText": "NSG nsg-abw-apim-<region>-001 (outbound\nrules only)\n100 allow AzureKeyVault 443: an APIM v2\nplatform dependency\n110 allow VirtualNetwork 443: the MCP apps\nand the Foundry private endpoints\n120 allow Internet 443: the vendor mock,\nEntra and Monitor through the NAT\nOnly these three custom rules; no custom\ninbound rules.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d02_0099",
