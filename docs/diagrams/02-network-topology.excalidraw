   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Why it exists: every data plane is\nprivate-endpoint-only, so the portal's data\npages fail from a laptop. From this VM the\nsame names resolve to the private\nendpoints.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0103",
   "originalText": "Why it exists: every data plane is\nprivate-endpoint-only, so the portal's data\npages fail from a laptop. From this VM the\nsame names resolve to the private\nendpoints.",
   "autoResize": true,
   "lineHeight": 1.25
  },
