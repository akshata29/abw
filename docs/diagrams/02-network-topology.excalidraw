   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Observed from inside the jump box (in-VM run command): 11 of 11 private names resolve to 10.42.1.x and answer on 443, 6 of 6 outbound hosts answer, and the egress address is\nthe NAT gateway's. Not observed: the Bastion browser session itself.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0120",
   "originalText": "Observed from inside the jump box (in-VM run command): 11 of 11 private names resolve to 10.42.1.x and answer on 443, 6 of 6 outbound hosts answer, and the egress address is\nthe NAT gateway's. Not observed: the Bastion browser session itself.",
   "autoResize": true,
   "lineHeight": 1.25
  },
