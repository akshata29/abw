   "opacity": 100,
   "groupIds": [
    "grp02_002"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1807563,
   "version": 1,
   "versionNonce": 21260013,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "What to notice",
   "fontSize": 20,
   "fontFamily": 2,
