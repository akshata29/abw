   "link": null,
   "locked": false,
   "text": "NAT gateway attached, so the VM's browser\nreaches Entra and the portal. Default\noutbound access off.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0101",
   "originalText": "NAT gateway attached, so the VM's browser\nreaches Entra and the portal. Default\noutbound access off.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
