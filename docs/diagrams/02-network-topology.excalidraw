   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "NSG nsg-abw-jump-<region>-001\n100 allow RDP 3389 from VirtualNetwork\n(Bastion)\n4000 deny all inbound from the Internet",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0099",
   "originalText": "NSG nsg-abw-jump-<region>-001\n100 allow RDP 3389 from VirtualNetwork\n(Bastion)\n4000 deny all inbound from the Internet",
   "autoResize": true,
   "lineHeight": 1.25
  },
