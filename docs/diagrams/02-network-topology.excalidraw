   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "From the jump box\nEntra sign-in, Azure portal, ai.azure.com, Azure Resource Manager, Microsoft Graph\nand the container registry host. The one-time console installers (Python, Azure CLI,\nPowerShell 7) pass the same way.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d02_0118",
   "originalText": "From the jump box\nEntra sign-in, Azure portal, ai.azure.com, Azure Resource Manager, Microsoft Graph\nand the container registry host. The one-time console installers (Python, Azure CLI,\nPowerShell 7) pass the same way.",
   "autoResize": true,
   "lineHeight": 1.25
  },
