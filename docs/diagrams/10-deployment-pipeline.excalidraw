   "seed": 2916428,
   "version": 1,
   "versionNonce": 25344548,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "0 = done\n1 = a required step failed, or a blocking problem\n2 = done, but an optional step failed\n3 = -CheckOnly found a blocker\nRerun the same command: finished steps are\nskipped and the failed one is retried.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "0 = done\n1 = a required step failed, or a blocking problem\n2 = done, but an optional step failed\n3 = -CheckOnly found a blocker\nRerun the same command: finished steps are\nskipped and the failed one is retried.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
