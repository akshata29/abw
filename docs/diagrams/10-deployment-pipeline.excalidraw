   "roundness": null,
   "seed": 3256945,
   "version": 1,
   "versionNonce": 29847895,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Each persona consents once to each of the 5 OAuth connections: the first agent call\nreturns a consent link, valid about 10 min. Foundry then keeps the token 60-90 min, so\na role change reaches the agent only with the next token.\nApply the role baseline (step 14) first: a role-less first consent leaves the agent with\nempty tool lists long after the roles are fixed (the token lives 60-90 min, the tool list\nabout 15-20 min).\nWhen: after steps 15 and 16.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d10_0284",
   "originalText": "Each persona consents once to each of the 5 OAuth connections: the first agent call\nreturns a consent link, valid about 10 min. Foundry then keeps the token 60-90 min, so\na role change reaches the agent only with the next token.\nApply the role baseline (step 14) first: a role-less first consent leaves the agent with\nempty tool lists long after the roles are fixed (the token lives 60-90 min, the tool list\nabout 15-20 min).\nWhen: after steps 15 and 16.",
   "autoResize": true,
   "lineHeight": 1.25
  },
