  },
  {
   "id": "d10_0285",
   "type": "text",
   "x": 770.0,
   "y": 2465.0,
   "width": 612.75,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
