   "versionNonce": 25030361,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "infra\\generated\\deploy-state.json holds, per step,\nstatus, time, attempts and a note, plus the last 50\nruns and the verify result. Written atomically, never\nby -CheckOnly.\nLog, one per run, in infra\\generated\\logs:\ndeploy-<yyyyMMdd-HHmmss>.log\nEach step's own result file sits beside the state file.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "infra\\generated\\deploy-state.json holds, per step,\nstatus, time, attempts and a note, plus the last 50\nruns and the verify result. Written atomically, never\nby -CheckOnly.\nLog, one per run, in infra\\generated\\logs:\ndeploy-<yyyyMMdd-HHmmss>.log\nEach step's own result file sits beside the state file.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d10_0241",
   "type": "text",
