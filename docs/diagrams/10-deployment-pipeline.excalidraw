   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Start-JumpBox.bat starts the VM, opens its portal page and copies the admin password\nfor 120 s. Then Connect > Bastion, start the 'ABW Demo Console' desktop shortcut\nand, on the first start, sign in once with a device code (az login) as the admin. Bastion\nDeveloper allows one session at a time.\nWhen: after the console (step 22) is installed on the VM.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d10_0296",
   "originalText": "Start-JumpBox.bat starts the VM, opens its portal page and copies the admin password\nfor 120 s. Then Connect > Bastion, start the 'ABW Demo Console' desktop shortcut\nand, on the first start, sign in once with a device code (az login) as the admin. Bastion\nDeveloper allows one session at a time.\nWhen: after the console (step 22) is installed on the VM.",
   "autoResize": true,
   "lineHeight": 1.25
  },
