  {
   "id": "d10_0053",
   "type": "text",
   "x": 1467.0,
   "y": 301.5,
   "width": 368.58,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp10_002"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1419737,
   "version": 1,
   "versionNonce": 5550767,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Chip = the step id that -From, -Only, -Until and -Skip\ntake. Number = run order. Letters A-E = the\norchestrator's own phases. est. = planning minutes,\nnot a guarantee. Grey H = a human-only step (zone\nbelow). White chip = operator-side tooling. Dashed\ncard = off by default. Default plan: steps 1-22.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Chip = the step id that -From, -Only, -Until and -Skip\ntake. Number = run order. Letters A-E = the\norchestrator's own phases. est. = planning minutes,\nnot a guarantee. Grey H = a human-only step (zone\nbelow). White chip = operator-side tooling. Dashed\ncard = off by default. Default plan: steps 1-22.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d10_0055",
   "type": "text",
   "x": 1923.0,
   "y": 268.5,
   "width": 161.18,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp10_003"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1435575,
   "version": 1,
   "versionNonce": 5760225,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Choose what runs",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Choose what runs",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d10_0056",
   "type": "text",
   "x": 1923.0,
   "y": 301.5,
   "width": 372.62,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp10_003"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1443494,
   "version": 1,
   "versionNonce": 5864954,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "By step id: -From, -Only, -Until, -Skip. Run again:\n-Force. Switches: -SkipJumpBox, -SkipConsole,\n-SkipFrontDoor, -SkipBudget, -SkipGuardrail; opt in\nwith -WithExtras (23-24) and -RunProofs (25-26).\n-ResetState archives the local state and starts fresh;\n-AdoptExistingEntra lets step 2 update abw-* objects\nalready in the tenant.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "By step id: -From, -Only, -Until, -Skip. Run again:\n-Force. Switches: -SkipJumpBox, -SkipConsole,\n-SkipFrontDoor, -SkipBudget, -SkipGuardrail; opt in\nwith -WithExtras (23-24) and -RunProofs (25-26).\n-ResetState archives the local state and starts fresh;\n-AdoptExistingEntra lets step 2 update abw-* objects\nalready in the tenant.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d10_0238",
