   "link": null,
   "locked": false,
   "text": "Also by hand: each persona signs in once to the Demo Console with a device code (it opens a private browser window and copies the code) before the 'Acting as' beats.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
