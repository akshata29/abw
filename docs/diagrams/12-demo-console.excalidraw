   "link": null,
   "locked": false,
   "text": "Show day: Start-JumpBox.bat starts the VM and\ncopies its password. In the Azure portal: the VM,\nConnect, Bastion. The first run also needs a\none-time az login with a device code as the\noperator.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0160",
   "originalText": "Show day: Start-JumpBox.bat starts the VM and\ncopies its password. In the Azure portal: the VM,\nConnect, Bastion. The first run also needs a\none-time az login with a device code as the\noperator.",
   "autoResize": true,
   "lineHeight": 1.25
  },
