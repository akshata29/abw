   "text": "Run: the desktop shortcut starts\nscripts\\jumpbox-console-start.ps1, which starts the\nconsole and opens Edge at http://127.0.0.1:8787/.\nClosing the window stops it.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0162",
   "originalText": "Run: the desktop shortcut starts\nscripts\\jumpbox-console-start.ps1, which starts the\nconsole and opens Edge at http://127.0.0.1:8787/.\nClosing the window stops it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
