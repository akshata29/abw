   "link": null,
   "locked": false,
   "text": "jobs.py (Manager): one button press is one job, in its own\nthread, with plain-English events the browser polls.\nDisruptive scenes never overlap each other or anything\nthat calls the gateway (the allow-list scene may run\nbeside an agent run); two agent runs never overlap;\nread-only jobs always run.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0040",
   "originalText": "jobs.py (Manager): one button press is one job, in its own\nthread, with plain-English events the browser polls.\nDisruptive scenes never overlap each other or anything\nthat calls the gateway (the allow-list scene may run\nbeside an agent run); two agent runs never overlap;\nread-only jobs always run.",
   "autoResize": true,
   "lineHeight": 1.25
  },
