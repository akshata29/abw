   "link": null,
   "locked": false,
   "text": "server.py: Starlette and uvicorn on 127.0.0.1 only (the\nnext free port if 8787 is busy). Serves the web UI and the\n/api routes. Sets security headers, accepts only localhost\nhost names and refuses a POST that is not same-origin.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0038",
   "originalText": "server.py: Starlette and uvicorn on 127.0.0.1 only (the\nnext free port if 8787 is busy). Serves the web UI and the\n/api routes. Sets security headers, accepts only localhost\nhost names and refuses a POST that is not same-origin.",
   "autoResize": true,
   "lineHeight": 1.25
  },
