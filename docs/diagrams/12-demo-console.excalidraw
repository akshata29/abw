   "link": null,
   "locked": false,
   "text": "Started by Start-Console.bat on the laptop, or by the ABW Demo Console desktop shortcut on the jump box. Either way the\noperator's az login is checked first and the browser opens on the console. Closing the window stops it.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0036",
   "originalText": "Started by Start-Console.bat on the laptop, or by the ABW Demo Console desktop shortcut on the jump box. Either way the\noperator's az login is checked first and the browser opens on the console. Closing the window stops it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
