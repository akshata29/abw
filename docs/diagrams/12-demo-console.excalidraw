   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "personas.py: signs a persona in once with a device code\nagainst abw-test-client, then asks for tokens silently, so a\njob never prompts. Passwords stay in .secrets and reach\nonly the clipboard; TOTP seeds never leave it (the page\ngets the 6-digit code).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d12_0047",
   "originalText": "personas.py: signs a persona in once with a device code\nagainst abw-test-client, then asks for tokens silently, so a\njob never prompts. Passwords stay in .secrets and reach\nonly the clipboard; TOTP seeds never leave it (the page\ngets the 6-digit code).",
   "autoResize": true,
   "lineHeight": 1.25
  },
