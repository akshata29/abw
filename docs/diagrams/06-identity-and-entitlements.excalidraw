  {
   "id": "d06_0210",
   "type": "text",
   "x": 60.0,
   "y": 1291.0,
   "width": 1485.87,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2263008,
   "version": 1,
   "versionNonce": 21993168,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Cells follow the app roles and tool rules in the code and the group RBAC in the platform template. Priya, Ian and the operator were run live; Wes, Tara and Carla are designed behaviour until each has signed in\nonce. The Search role covers the whole index: the public/wall split inside it is a server-side filter in the MCP server (Wall 2). sg-abw-demo-all holds Foundry Agent Consumer on the project, so every persona can\ntalk to the agents. The operator holds no data-plane role: Owner is not data access.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cells follow the app roles and tool rules in the code and the group RBAC in the platform template. Priya, Ian and the operator were run live; Wes, Tara and Carla are designed behaviour until each has signed in\nonce. The Search role covers the whole index: the public/wall split inside it is a server-side filter in the MCP server (Wall 2). sg-abw-demo-all holds Foundry Agent Consumer on the project, so every persona can\ntalk to the agents. The operator holds no data-plane role: Owner is not data access.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
