   "seed": 2714391,
   "version": 1,
   "versionNonce": 27962721,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Deliberately broad, the typical\nPOC. Read on all of Storage and\nSearch, Cosmos DB data\ncontributor on the account, plus\naudit append and AcrPull.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Deliberately broad, the typical\nPOC. Read on all of Storage and\nSearch, Cosmos DB data\ncontributor on the account, plus\naudit append and AcrPull.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d06_0271",
   "type": "text",
   "x": 76.0,
   "y": 1452.0,
   "width": 127.84,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
