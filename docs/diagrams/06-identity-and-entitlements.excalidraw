   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "AcrPull. Key Vault Secrets User,\ngranted but not used: the vendor\napp holds its own copy of the key\nas a Container Apps secret.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "AcrPull. Key Vault Secrets User,\ngranted but not used: the vendor\napp holds its own copy of the key\nas a Container Apps secret.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d06_0264",
   "type": "text",
   "x": 1640.0,
   "y": 1111.5,
   "width": 315.71,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2690634,
   "version": 1,
   "versionNonce": 27648534,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "The gateway checks the user's token for\nvendor and injects the vendor key. Legacy is\nthe before picture: one broad identity and no\nuser context.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The gateway checks the user's token for\nvendor and injects the vendor key. Legacy is\nthe before picture: one broad identity and no\nuser context.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d06_0266",
   "type": "text",
   "x": 2054.0,
   "y": 1121.5,
   "width": 151.02,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp06_017"
   ],
   "frameId": null,
