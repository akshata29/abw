   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Wall 2: verify T2 again (RS256 signature via JWKS, audience, v2.0\nissuer, tid, azp allow-list, scp Tools.Read). Then the tool's own rule:\nthe project (falcon) must be in the token's roles.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d04_0115",
   "originalText": "Wall 2: verify T2 again (RS256 signature via JWKS, audience, v2.0\nissuer, tid, azp allow-list, scp Tools.Read). Then the tool's own rule:\nthe project (falcon) must be in the token's roles.",
   "autoResize": true,
   "lineHeight": 1.25
  },
