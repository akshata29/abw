   "link": null,
   "locked": false,
   "text": "Foundry keeps T2 for this user and connection and reuses it until it\nexpires (Entra lifetimes are 60-90 min). A role change reaches the agent\nonly when that token expires.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d04_0094",
