   "text": "B. Every call after that: the steady state, until the token Foundry holds expires (60-90 minutes)",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d04_0096",
   "originalText": "B. Every call after that: the steady state, until the token Foundry holds expires (60-90 minutes)",
