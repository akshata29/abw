   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Wall 1: validate-jwt (audience = the wall API app, tenant, tid), then\nabw-deny (kill switch, azp allow-list, scope, role) and 120 calls per\nminute per user. Adds x-abw-request-id.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d04_0108",
   "originalText": "Wall 1: validate-jwt (audience = the wall API app, tenant, tid), then\nabw-deny (kill switch, azp allow-list, scope, role) and 120 calls per\nminute per user. Adds x-abw-request-id.",
   "autoResize": true,
   "lineHeight": 1.25
  },
