   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "2.1 takes 4-6 min and deletes its throw-away resources. CORRECTED means an organisation\nModify policy rewrote the change to a safe value first.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2.1 takes 4-6 min and deletes its throw-away resources. CORRECTED means an organisation\nModify policy rewrote the change to a safe value first.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0140",
   "type": "text",
   "x": 1616.0,
   "y": 516.5,
   "width": 693.62,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1908684,
   "version": 1,
   "versionNonce": 14662164,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "No gateway in front of the private server: the kill switch and rate limit do not cover it. W1 applies to\nthe vendor path only.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No gateway in front of the private server: the kill switch and rate limit do not cover it. W1 applies to\nthe vendor path only.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0143",
   "type": "text",
   "x": 160.0,
   "y": 621.5,
   "width": 609.18,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1932441,
   "version": 1,
   "versionNonce": 14976351,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "The answer comes from the token, not the prompt. 1.2 is the model being polite; 1.4 is\nthe enforced stop.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The answer comes from the token, not the prompt. 1.2 is the model being polite; 1.4 is\nthe enforced stop.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0154",
   "type": "text",
   "x": 930.0,
   "y": 621.5,
   "width": 600.26,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2019550,
   "version": 1,
   "versionNonce": 16128370,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Keys are off everywhere, and the platform rejects or rewrites unsafe changes, shown\nwith real requests.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Keys are off everywhere, and the platform rejects or rewrites unsafe changes, shown\nwith real requests.",
   "autoResize": true,
   "lineHeight": 1.25
  },
