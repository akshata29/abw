   "seed": 4331898,
   "version": 1,
   "versionNonce": 46709238,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Each cell carries an evidence chip: live (a request just made), rbac (role assignment read live), logs\n(read back from Log Analytics) or design (not run). A person who has not signed in once (key P)\nshows design.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each cell carries an evidence chip: live (a request just made), rbac (role assignment read live), logs\n(read back from Log Analytics) or design (not run). A person who has not signed in once (key P)\nshows design.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0465",
   "type": "text",
   "x": 1412.0,
   "y": 2038.0,
   "width": 400.24,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 4482359,
   "version": 1,
   "versionNonce": 48699089,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "The budget mails the resource-group Owners at 50, 80\nand 100 % of actual spend and at 100 % forecast. Azure\nbills hours late. No price per token is shown.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The budget mails the resource-group Owners at 50, 80\nand 100 % of actual spend and at 100 % forecast. Azure\nbills hours late. No price per token is shown.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0485",
   "type": "text",
   "x": 1872.0,
   "y": 1982.0,
   "width": 419.74,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 4640739,
   "version": 1,
   "versionNonce": 50793669,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Alternate: abw-agent-rpm set to 1 gives HTTP 429\nrate_limited with Retry-After of about 100 s. Both are global\nsettings: use a demo tenant only.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Alternate: abw-agent-rpm set to 1 gives HTTP 429\nrate_limited with Retry-After of about 100 s. Both are global\nsettings: use a demo tenant only.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_0488",
   "type": "text",
   "x": 160.0,
   "y": 2209.0,
   "width": 1171.26,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 4664496,
   "version": 1,
   "versionNonce": 51107856,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Different person, different answer, read from the token. The agent enters through the same gateway, and spend and a per-user token ceiling are visible and enforced.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Different person, different answer, read from the token. The agent enters through the same gateway, and spend and a per-user token ceiling are visible and enforced.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
