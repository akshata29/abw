   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The first call after idle takes 10-20 s.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
