   "versionNonce": 20108137,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "The Container Apps replica count: it should stay at the minimum of 1.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The Container Apps replica count: it should stay at the minimum of 1.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d13_0193",
   "type": "text",
   "x": 1530.0,
   "y": 1694.0,
   "width": 736.27,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2828406,
   "version": 1,
   "versionNonce": 20212866,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Run abw-warm before the demo (30-60 s; it warms the gateway, every MCP replica and Foundry). Keep\nminimum replicas at 1.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Run abw-warm before the demo (30-60 s; it warms the gateway, every MCP replica and Foundry). Keep\nminimum replicas at 1.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d13_0197",
   "type": "text",
