   "link": null,
   "locked": false,
   "text": "Blast radius: Storage, Cosmos and Search have no public path, and\nthe five internal MCP servers are reachable only from the VNet. The\nvendor mock is public and protected by one static key.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0137",
   "originalText": "Blast radius: Storage, Cosmos and Search have no public path, and\nthe five internal MCP servers are reachable only from the VNet. The\nvendor mock is public and protected by one static key.",
