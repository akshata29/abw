   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Role: the APIM gateway (a user token, or the subscription key on\n/legacy), the Foundry endpoint (keyless, Entra only), Container\nRegistry (admin off, pull needs AcrPull), Key Vault (default-Deny; the\nNAT IP and trusted Azure services allowed) and the vendor mock (a\npublic Container Apps environment).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0135",
   "originalText": "Role: the APIM gateway (a user token, or the subscription key on\n/legacy), the Foundry endpoint (keyless, Entra only), Container\nRegistry (admin off, pull needs AcrPull), Key Vault (default-Deny; the\nNAT IP and trusted Azure services allowed) and the vendor mock (a\npublic Container Apps environment).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
