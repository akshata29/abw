   "link": null,
   "locked": false,
   "text": "Closed: no data-plane role, no data.\nStorage answers 403 and the server\nreports storage_rbac_denied. Nobody\nholds a role on wall-orion.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
