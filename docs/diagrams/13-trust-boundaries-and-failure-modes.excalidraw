   "versionNonce": 20631782,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "The tool answers FORBIDDEN obo_failed:<code>.",
   "fontSize": 16,
