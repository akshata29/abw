   "text": "Role: validates the token, then refuses\na revoked user, a client not on the\nallow-list, a missing scope or a missing\nrole. Rate limit: 120 calls per 60 s per\nuser.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0079",
   "originalText": "Role: validates the token, then refuses\na revoked user, a client not on the\nallow-list, a missing scope or a missing\nrole. Rate limit: 120 calls per 60 s per\nuser.",
   "autoResize": true,
   "lineHeight": 1.25
  },
