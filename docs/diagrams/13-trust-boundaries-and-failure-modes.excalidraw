   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Role: internal Container Apps\nenvironment in the VNet. Re-verifies\nthe token, filters tools by role, then\nswaps the token (OBO, with its T3\nassertion) for the user's own T4a/b/c.\nOne UAMI per server.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0087",
   "originalText": "Role: internal Container Apps\nenvironment in the VNet. Re-verifies\nthe token, filters tools by role, then\nswaps the token (OBO, with its T3\nassertion) for the user's own T4a/b/c.\nOne UAMI per server.",
   "autoResize": true,
   "lineHeight": 1.25
  },
