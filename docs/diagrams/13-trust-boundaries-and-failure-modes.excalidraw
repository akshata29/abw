   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Blast radius: its UAMI (audit append\nand image pull; actions also reads the\nrestricted list; vendor reads one Key\nVault secret) plus the user tokens it is\nhandling. Legacy is deliberately broad.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0089",
   "originalText": "Blast radius: its UAMI (audit append\nand image pull; actions also reads the\nrestricted list; vendor reads one Key\nVault secret) plus the user tokens it is\nhandling. Legacy is deliberately broad.",
   "autoResize": true,
   "lineHeight": 1.25
  },
