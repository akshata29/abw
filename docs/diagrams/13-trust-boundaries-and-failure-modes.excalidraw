   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Role: Storage, Cosmos and Search\naccept private traffic only, with no\nkeys. The data plane's own roles are\nchecked on the user's own T4a/b/c\ntoken.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0095",
   "originalText": "Role: Storage, Cosmos and Search\naccept private traffic only, with no\nkeys. The data plane's own roles are\nchecked on the user's own T4a/b/c\ntoken.",
   "autoResize": true,
   "lineHeight": 1.25
  },
