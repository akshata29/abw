   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "Closed: refuses a bad token (401) or a\nmissing scope (403). A tool the caller\nhas no role for, a project not in the\ntoken roles or an OBO failure gets a\nDENIED result (HTTP 200). All are\nlogged.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d13_0091",
   "originalText": "Closed: refuses a bad token (401) or a\nmissing scope (403). A tool the caller\nhas no role for, a project not in the\ntoken roles or an OBO failure gets a\nDENIED result (HTTP 200). All are\nlogged.",
   "autoResize": true,
   "lineHeight": 1.25
  },
