   "versionNonce": 20736511,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1735689600000,
   "link": null,
   "locked": false,
   "text": "KQL AbwMcpAudit (event tool_denied, reason obo_failed:<code>). The UAMI\nand its federated credential on the API app.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "KQL AbwMcpAudit (event tool_denied, reason obo_failed:<code>). The UAMI\nand its federated credential on the API app.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d13_0199",
   "type": "text",
   "x": 1530.0,
   "y": 1752.0,
   "width": 747.94,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
