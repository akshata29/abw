   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The front door forwards T1 unchanged. The private MCP server skips the gateway: Foundry sends T2 to it directly, and only the server checks it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
